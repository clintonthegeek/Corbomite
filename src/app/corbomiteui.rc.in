<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="@CORBOMITE_COMPONENT_NAME@" version="17">
  <!--
    BUMP `version` WHENEVER THIS FILE'S MENUS/ACTIONS CHANGE.

    KXMLGUI writes a merged copy of this file to
    ~/.local/share/kxmlgui5/<component>/ and only rewrites it when the version
    here is newer than the cached one. `0c4b224f` added `<Menu name="tab">`
    without a bump, so every install that already had a version-13 cache kept
    a menubar with no Tab menu — invisible to the tests, which run in
    QStandardPaths test mode and therefore always build a fresh cache. Found
    live 2026-10-18 (the menubar read "File Edit View Go Settings Help Format
    Heading Insert Table"). Bumping to 14 makes the next launch rewrite the
    cache once; a stuck menu can always be cleared by deleting the cached file
    (see docs/USER-TESTING.md, "How to build and run").
  -->
  <MenuBar>
    <Menu name="file">
      <text>&amp;File</text>
      <Action name="file_open_vault"/>
      <Action name="file_open_recent"/>
      <Action name="file_close_vault"/>
      <Separator/>
      <Action name="file_new_note"/>
      <Action name="file_new_canvas"/>
      <Action name="file_new_base"/>
      <Separator/>
      <Action name="file_save"/>
      <Separator/>
    </Menu>
    <!-- Cut/Copy/Paste/Copy
         as.../Paste as Plain Text used to live here too; they now arrive
         via MarkdownViewActions' <Menu name="edit"> merge (the same mechanism
         the View menu's Editor Mode group uses) and
         vanish entirely off markdown, matching every other leaf-specific
         verb. This base container only ever holds the universal items. -->
    <Menu name="edit">
      <text>&amp;Edit</text>
      <Action name="edit_undo"/>
      <Action name="edit_redo"/>
      <Separator/>
      <Action name="edit_find"/>
      <Action name="edit_find_next"/>
      <Action name="edit_find_previous"/>
      <Action name="edit_replace"/>
    </Menu>
    <!-- Where each ViewActions provider's
         context-sensitive top-level menu (Format/Heading/Insert/Table for
         markdown, Graph, Bases, Canvas, ...) goes.

         There is no merge point here on purpose. KXMLGUI resolves a child
         client's `append="X"` as *"insert me immediately before the existing
         element named X"* (KXMLGUIClient::mergeXML), not "into X" and not
         "at the merge point X" — an `append` that names no existing element
         silently falls through to the end of the menubar, past the Settings
         and Help menus KXMLGUI adds at runtime. So every provider declares
         `append="view"`, which lands its menu directly after Edit, where the
         editing-adjacent verbs belong. Settings and Help then stay rightmost
         as a pair. Never declare a `<Merge`/`<MergeLocal`> point for this.
         REMEMBER: bump `version` on the <gui> element when this file changes
         (the cache is keyed on it). -->
    <Menu name="go">
      <text>&amp;Go</text>
      <Action name="quick_switcher"/>
      <Action name="command_palette"/>
      <Separator/>
      <Action name="search_vault"/>
      <Action name="graph_view"/>
      <Separator/>
      <Action name="open_daily_note"/>
      <Separator/>
      <Action name="tab_next"/>
      <Action name="tab_prev"/>
      <Action name="tab_close"/>
    </Menu>
    <!-- A real Tab menu.
         These were originally appended to the Go menu above, with a comment
         asserting they "belong in the always-present Tab menu" — a menu that
         did not exist. Reported by the user as "I can't find the tab menu".
         Tab order and linked-pane grouping are tab concerns, not navigation
         concerns, so they get their own top-level menu rather than living
         under Go where nobody looks for them. Always present: these are
         universal (workspace-scoped), so this is a base container, never a
         ViewActions provider merge. -->
    <Menu name="tab">
      <text>&amp;Tab</text>
      <Action name="tab_move_left"/>
      <Action name="tab_move_right"/>
      <Separator/>
      <Action name="leaf_link_with_active_pane"/>
    </Menu>
    <!-- split_right/split_down/sidebar/zoom are
         universal (no view-type dependency). editor_toggle_mode, the
         Editor Mode radios, and the fold trio used to live here too; they
         now arrive via MarkdownViewActions' <Menu name="view"> merge
         and vanish entirely off markdown — this base container
         only ever holds the universal items. -->
    <Menu name="view">
      <text>&amp;View</text>
      <Action name="split_right"/>
      <Action name="split_down"/>
      <Separator/>
      <Action name="view_toggle_left_sidebar"/>
      <Separator/>
      <Action name="view_zoom_in"/>
      <Action name="view_zoom_out"/>
      <Action name="view_zoom_reset"/>
    </Menu>
  </MenuBar>
  <ToolBar name="mainToolBar" noMerge="1" iconText="icononly">
    <text>Main Toolbar</text>
    <Action name="file_open_vault"/>
    <Action name="file_new_note"/>
    <Action name="file_save"/>
    <Separator/>
    <Action name="quick_switcher"/>
    <Action name="command_palette"/>
    <Action name="search_vault"/>
    <Action name="graph_view"/>
  </ToolBar>
</gui>
