<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="@CORBOMITE_COMPONENT_NAME@" version="8">
  <MenuBar>
    <Menu name="file">
      <text>&amp;File</text>
      <Action name="file_open_vault"/>
      <Action name="file_open_recent"/>
      <Separator/>
      <Action name="file_new_note"/>
      <Action name="file_new_canvas"/>
      <Separator/>
      <Action name="file_save"/>
      <Separator/>
    </Menu>
    <Menu name="edit">
      <text>&amp;Edit</text>
      <Action name="edit_undo"/>
      <Action name="edit_redo"/>
      <Separator/>
      <Action name="edit_find"/>
    </Menu>
    <Menu name="go">
      <text>&amp;Go</text>
      <Action name="quick_switcher"/>
      <Action name="command_palette"/>
      <Separator/>
      <Action name="search_vault"/>
      <Action name="graph_view"/>
      <Separator/>
      <Action name="open_daily_note"/>
      <Action name="insert_template"/>
      <Separator/>
      <Action name="tab_next"/>
      <Action name="tab_prev"/>
      <Action name="tab_close"/>
    </Menu>
    <Menu name="view">
      <text>&amp;View</text>
      <Action name="editor_toggle_mode"/>
      <Separator/>
      <Action name="split_right"/>
      <Action name="split_down"/>
      <Separator/>
      <Action name="view_toggle_left_sidebar"/>
      <Separator/>
      <Action name="view_zoom_in"/>
      <Action name="view_zoom_out"/>
      <Action name="view_zoom_reset"/>
    </Menu>
  </MenuBar>
  <ToolBar name="mainToolBar" noMerge="1">
    <text>Main Toolbar</text>
    <Action name="file_open_vault"/>
    <Action name="file_new_note"/>
    <Action name="file_save"/>
    <Separator/>
    <Action name="quick_switcher"/>
    <Action name="command_palette"/>
    <Action name="search_vault"/>
    <Action name="graph_view"/>
    <Separator/>
    <Action name="editor_toggle_mode"/>
  </ToolBar>
</gui>
