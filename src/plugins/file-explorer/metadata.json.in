{
    "KPlugin": {
        "Name": "File Explorer",
        "Description": "Browse the active vault as a hierarchical tree",
        "Icon": "folder",
        "Version": "1.0",
        "License": "GPL-3.0-or-later",
        "Category": "Core",
        "EnabledByDefault": true,
        "Authors": [{"Name": "Corbomite Developers"}]
    },
    "X-Corbomite-Trusted": @X_CORBOMITE_TRUSTED@,
    "X-Obsidian-Id": "file-explorer",
    "X-Corbomite-Permissions": ["vault.read", "vault.write", "vault.events", "workspace", "ui.views", "ui.menus", "ui.commands"],
    "X-Corbomite-MinVersion": "0.1.0",
    "X-Corbomite-DockArea": "left",
    "X-Corbomite-DockIcon": "folder",
    "X-Corbomite-DockTitle": "Files"
}
