{
    "KPlugin": {
        "Name": "Outlinks",
        "Description": "Show notes that the active note links to",
        "Icon": "go-jump",
        "Version": "1.0",
        "License": "GPL-3.0-or-later",
        "Category": "Core",
        "EnabledByDefault": true,
        "Authors": [{"Name": "Corbomite Developers"}]
    },
    "X-Corbomite-Trusted": @X_CORBOMITE_TRUSTED@,
    "X-Corbomite-Permissions": ["metadata.read", "vault.read", "vault.write", "workspace", "ui.views"],
    "X-Corbomite-MinVersion": "0.1.0",
    "X-Corbomite-DockArea": "right",
    "X-Corbomite-DockIcon": "go-jump",
    "X-Corbomite-DockTitle": "Outlinks"
}
